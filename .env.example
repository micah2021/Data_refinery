# Copy this file to .env for local development.
# Never commit your real secrets to source control.

DB_PATH=./nigeria.db
SCHEMA_PATH=./nigeria_db_schema.sql
LOG_LEVEL=INFO

DHIS2_URL=https://example-dhis2.org
DHIS2_USER=your-dhis2-username
DHIS2_PASS=your-dhis2-password

NCDC_API_KEY=replace-with-ncdc-api-key
WORLD_BANK_KEY=replace-with-world-bank-api-key
FAO_KEY=replace-with-fao-api-key
NIMET_KEY=replace-with-nimet-api-key
